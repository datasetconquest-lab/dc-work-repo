# Server Configuration
NODE_ENV=development
PORT=3001

# MongoDB Atlas Configuration
# Get this from MongoDB Atlas Dashboard -> Connect -> Connect your application
# Password special characters need to be URL encoded: @ = %40
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/dc_teams?retryWrites=true&w=majority

# JWT Configuration
# Generate a strong secret key for production (e.g. openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
# Set to your frontend URL(s), comma-separated for multiple
CORS_ORIGIN=http://localhost:5173

# EDA portal — the Research Assistant Python (FastAPI) companion service.
# The Node server proxies /api/eda/*/run and job polling here.
EDA_SERVICE_URL=http://127.0.0.1:8765

# Org-wide always-allowed IP range(s), comma-separated. Applied to every user in
# addition to their own allowed_ips. Use a CIDR block (e.g. 103.218.112.0/24)
# when the public IP changes daily but stays within a range. Leave empty to
# disable the global allow-list.
GLOBAL_ALLOWED_IPS=103.218.112.0/24

# SendGrid Email Configuration
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=noreply@yourdomain.com

# Optional: Attendance configuration
# ATTENDANCE_DISABLED_EMAILS=venkat.dataconquest@outlook.com,swathi.dataconquest@outlook.com
# ATTENDANCE_EXPORT_RECIPIENTS=admin1@example.com,admin2@example.com
# ATTENDANCE_EXPORT_TEST_RECIPIENT=admin@example.com
